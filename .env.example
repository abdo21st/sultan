# Copy to .env.local for local development. Replace every example value privately.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sultan_db?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/sultan_db?schema=public"
AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
ORDER_SHARE_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
CRON_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
AUTH_URL="https://your-public-domain.example"
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="SET_A_UNIQUE_PASSWORD_OF_AT_LEAST_6_CHARACTERS"
WHATSAPP_API_ALLOWED_HOSTS="api.example.com"
DB_PASSWORD="SET_A_UNIQUE_DATABASE_PASSWORD"
DB_BACKUP_ENCRYPTION_KEY="SET_BASE64_ENCODED_32_BYTE_KEY_FROM_A_SECRET_MANAGER"
# Connect this token to a private Vercel Blob store before enabling image uploads.
# Cloud Docker uses local private storage instead of requiring this token.
ORDER_IMAGE_STORAGE="vercel"
# For local private storage use an absolute path outside public and .next/static.
# ORDER_IMAGE_STORAGE_DIR="/app/storage/order-images"
BLOB_READ_WRITE_TOKEN=""
# Optional token for a separate legacy public store; needed to remove old public blobs.
BLOB_LEGACY_PUBLIC_READ_WRITE_TOKEN=""
