# dependencies
/node_modules
/__pycache__/
*.pyc
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# Android Build & Keystore
*.keystore
*.jks
*.apk
!public/downloads/*.apk
*.aab
app-release-unsigned-aligned.apk
manifest-checksum.txt
android/
android-app-module-backup/
.gradle/

# misc
.DS_Store
*.pem
.pnpm/
Untitled-1.txt

