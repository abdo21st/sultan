npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Local operations material may contain infrastructure details or data extracts.
/SERVER_GUIDE.md
/scratch/
/local-backups/
/storage/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
