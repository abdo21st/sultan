# Copy to /opt/sultan-production/.env.backup-offsite (root:root, mode 600).
# Fill values on the server only. Never commit the populated file.
SULTAN_S3_ENDPOINT=
SULTAN_S3_REGION=auto
SULTAN_S3_BUCKET=
SULTAN_S3_ACCESS_KEY_ID=
SULTAN_S3_SECRET_ACCESS_KEY=
SULTAN_S3_PREFIX=sultan/
SULTAN_S3_FORCE_PATH_STYLE=true
