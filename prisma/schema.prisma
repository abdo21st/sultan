generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  ACCOUNTANT
  USER
}

enum BlobDeletionStatus {
  PENDING
  NEEDS_ATTENTION
}

model User {
  id          String  @id @default(cuid())
  username    String  @unique
  password    String // Hashed password
  mustChangePassword Boolean @default(false)
  sessionVersion Int @default(0)
  displayName String
  phoneNumber String? // For WhatsApp notifications
  role        Role    @default(USER) // Legacy Enum, kept for safe migration

  // New Relation: Multi-role support
  roles CustomRole[]

  permissions String[] @default([]) // Overrides or extra permissions
  facilityId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CustomRole {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "ADMIN", "MANAGER"
  displayName String
  description String?
  permissions String[]
  users       User[]
}

model SystemSettings {
  id               String   @id @default("default") // Singleton row
  appName          String   @default("سلطان")
  logoUrl          String?
  printHeader      String?
  printFooter      String?
  printTerms       String?
  themeColor       String   @default("#d97706") // Default amber
  whatsappAutoSend Boolean  @default(false) // تفعيل/تعطيل الإرسال التلقائي
  whatsappApiUrl   String? // رابط WhatsApp API
  whatsappApiKey   String? // مفتاح API
  updatedAt        DateTime @updatedAt
}

model Facility {
  id       String  @id @default(cuid())
  name     String
  type     String
  location String?

  factoryOrders Order[]       @relation("FactoryOrders")
  shopOrders    Order[]       @relation("ShopOrders")
  transactions  Transaction[]
}

model Order {
  id              String        @id @default(cuid())
  clientRequestId String?       @unique
  shareVersion    Int           @default(0)
  serialNumber    Int           @default(autoincrement())
  customerName    String
  customerPhone   String
  description     String
  dueDate         DateTime
  status          String        @default("orders:status:registered")
  totalAmount     Decimal       @db.Decimal(14, 2)
  paidAmount      Decimal       @db.Decimal(14, 2)
  remainingAmount Decimal       @default(0) @db.Decimal(14, 2)
  images          String[]
  factoryId       String
  factory         Facility      @relation("FactoryOrders", fields: [factoryId], references: [id])
  shopId          String
  shop            Facility      @relation("ShopOrders", fields: [shopId], references: [id])
  rejectionReason String?
  reviewRequired  Boolean       @default(false)
  paymentNote     String?
  transactions    Transaction[]
  alertDeliveries AlertDelivery[]
  adjustments     OrderAdjustment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([factoryId])
  @@index([factoryId, dueDate])
  @@index([factoryId, createdAt, id])
  @@index([shopId])
  @@index([shopId, createdAt, id])
  @@index([status])
  @@index([customerPhone])
  @@index([createdAt, id])
}

model Transaction {
  id             String    @id @default(cuid())
  type           String
  amount         Decimal   @db.Decimal(14, 2)
  category       String
  description    String?
  orderId        String? // Link to specific Order
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  adjustmentId   String?
  adjustment     OrderAdjustment? @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  facilityId     String?
  facility       Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  idempotencyKey String?   @unique
  reversalOfId   String?   @unique
  reversalOf     Transaction? @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversedBy     Transaction? @relation("TransactionReversal")
  reversalReason String?
  customerId     String? // Link to specific Customer (if we normalize customers later)
  date           DateTime  @default(now())
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([date])
  @@index([date, id])
  @@index([facilityId, date, id])
  @@index([orderId])
  @@index([facilityId])
  @@index([adjustmentId])
}

model OrderAdjustment {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestKey      String   @unique
  kind            String
  status          String   @default("REQUESTED")
  reason          String
  requestedBy     String
  requestedAt     DateTime @default(now())
  originalStatus  String
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?
  refundAmount    Decimal  @default(0) @db.Decimal(14, 2)
  refundedAmount  Decimal  @default(0) @db.Decimal(14, 2)
  transactions    Transaction[]

  @@index([status, requestedAt])
  @@index([orderId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([userId, read, createdAt, id])
}

model CapacityRule {
  id           String    @id @default(cuid())
  factoryId    String? // Null means applies to all factories
  dayOfWeek    Int? // 0-6 (Sunday-Saturday), null means specific date
  specificDate DateTime?
  maxCapacity  Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([factoryId])
  @@index([dayOfWeek])
  @@index([specificDate])
}

model AlertSetting {
  id              String   @id @default(cuid())
  name            String
  triggerStatus   String // e.g., "REGISTERED", "DELIVERED"
  timingDays      Int      @default(0) // 0 means at the day, -1 means day before
  whatsappEnabled Boolean  @default(false)
  recipientPhones String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deliveries      AlertDelivery[]
}

// One delivery per rule, order, business day and recipient. External sends are
// claimed before contacting the provider so an uncertain result is never retried blindly.
model AlertDelivery {
  id             String       @id @default(cuid())
  alertSettingId String
  alertSetting   AlertSetting @relation(fields: [alertSettingId], references: [id], onDelete: Cascade)
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  scheduledDay   DateTime     @db.Date
  channel        String
  recipient      String
  status         String
  errorCode      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([alertSettingId, orderId, scheduledDay, channel, recipient])
  @@index([status, createdAt])
}

model ScheduledJobState {
  id            String   @id
  lastStartedAt DateTime?
  lastSuccessAt DateTime?
  lastError     String?
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  entityType String
  entityId   String
  action     String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model BlobDeletion {
  id            String             @id @default(cuid())
  url           String             @unique
  sourceOrderId String?
  status        BlobDeletionStatus @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now())
  lastError     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, nextAttemptAt, createdAt])
}
